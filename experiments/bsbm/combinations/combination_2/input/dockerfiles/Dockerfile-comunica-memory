# When bumping, match the versioned config import in comunica-memory-config.json to config/config-default.json in this image.
FROM comunica/query-sparql-file:dev@sha256:ffad9ac85899079fe8a91be03b48ad0b0688d0e023c0401d0c6c3e286f57a1c3

ARG CONFIG_CLIENT
ARG QUERY_TIMEOUT
ARG MAX_MEMORY
ARG LOG_LEVEL

ADD $CONFIG_CLIENT /tmp/config.json

ENV COMUNICA_CONFIG=/tmp/config.json
ENV NODE_ENV=production
ENV MAX_MEMORY=$MAX_MEMORY
ENV QUERY_TIMEOUT=$QUERY_TIMEOUT
ENV LOG_LEVEL=$LOG_LEVEL

EXPOSE 3000

ENTRYPOINT []
CMD [ "/bin/sh", "-c", "node --max-old-space-size=$MAX_MEMORY --max-semi-space-size=256 ./bin/http.js -c /tmp/context.json -p 3000 -t $QUERY_TIMEOUT -l $LOG_LEVEL" ]
