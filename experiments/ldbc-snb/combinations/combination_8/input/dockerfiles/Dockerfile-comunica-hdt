# Adds the HDT actor to the Comunica master dev image, installing it from npm instead of the image's build-time registry
FROM comunica/query-sparql-file:dev@sha256:ffad9ac85899079fe8a91be03b48ad0b0688d0e023c0401d0c6c3e286f57a1c3

RUN npm config set @comunica:registry https://registry.npmjs.org/ && \
    npm install --no-save --omit=dev @comunica/actor-query-source-identify-hdt@5.0.1 @comunica/config-query-sparql-hdt@5.0.1 && \
    test -f node_modules/hdt/build/Release/hdt.node

ARG CONFIG_CLIENT
ARG QUERY_TIMEOUT
ARG MAX_MEMORY
ARG LOG_LEVEL

ADD $CONFIG_CLIENT /tmp/config.json

ENV COMUNICA_CONFIG=/tmp/config.json
ENV NODE_ENV=production
ENV MAX_MEMORY=$MAX_MEMORY
ENV QUERY_TIMEOUT=$QUERY_TIMEOUT
ENV LOG_LEVEL=$LOG_LEVEL
# Generic query executions per worker before it accepts requests, to warm up the JIT compiler
# (the dataset is loaded during this warm-up; comunica-ingestion-timer.js reports how long that loading takes)
ENV WARMUP=2000

EXPOSE 3000

ENTRYPOINT []
CMD [ "/bin/sh", "-c", "node --max-old-space-size=$MAX_MEMORY --max-semi-space-size=256 $([ -f /tmp/comunica-ingestion-timer.js ] && echo --require /tmp/comunica-ingestion-timer.js) ./bin/http.js -c /tmp/context.json -p 3000 -t $QUERY_TIMEOUT -l $LOG_LEVEL --warmup $WARMUP" ]
